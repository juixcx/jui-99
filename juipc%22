-- =============================================
-- calculateVelocity
-- =============================================
local function calculateVelocity(aM)
    local aN = aK[aM]
    if not aN or #aN < 2 then return Vector3.new() end
    local aO = Vector3.new()
    local aP = 0
    for aQ = 2, #aN do
        local aR = aN[aQ].time - aN[aQ - 1].time
        if aR > 0 then
            aO = aO + (aN[aQ].pos - aN[aQ - 1].pos) / aR
            aP = aP + 1
        end
    end
    if aP == 0 then return Vector3.new() end
    local aQ = aO / aP
    if aQ.Y > aI then
        return Vector3.new(aQ.X * 1.15, math.clamp(aQ.Y * 0.85, 0, 400), aQ.Z * 1.15)
    end
    return aQ
end

-- =============================================
