local function applyBoostFPS()
    pcall(function()
        local s = settings()
        if s then
            s.Rendering.QualityLevel = 1
            s.Rendering.AntiAliasing = Enum.AntiAliasingType.None
            s.Rendering.Shadows = false
        end
    end)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") then
            v.Enabled = false
        end
    end
    local lighting = game:GetService("Lighting")
    if lighting then
        lighting.GlobalShadows = false
        lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        lighting.Outlines = false
        lighting.Technology = Enum.Technology.Compatibility
    end
end

local function revertBoostFPS()
    pcall(function()
        local s = settings()
        if s then
            s.Rendering.QualityLevel = 7
            s.Rendering.AntiAliasing = Enum.AntiAliasingType.Default
            s.Rendering.Shadows = true
        end
    end)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") then
            v.Enabled = true
        end
    end
    local lighting = game:GetService("Lighting")
    if lighting then
        lighting.GlobalShadows = true
        lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        lighting.Outlines = true
        lighting.Technology = Enum.Technology.Legacy
    end
end

