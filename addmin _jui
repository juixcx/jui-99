local function updateFOVDecagon()
    local viewportSize = y.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local rainbowColor = Color3.fromHSV((tick() % 5) / 5, 1, 1)
    
    H = fovRadius -- ให้ค่า H (ระยะ FOV สำหรับเล็ง) ปรับตามขนาดของ FOV ที่ผู้เล่นตั้งค่า
    
    for i = 1, fovSides do
        local angle1 = (i - 1) * (2 * math.pi / fovSides)
        local angle2 = i * (2 * math.pi / fovSides)
        
        local p1 = center + Vector2.new(math.cos(angle1) * fovRadius, math.sin(angle1) * fovRadius)
        local p2 = center + Vector2.new(math.cos(angle2) * fovRadius, math.sin(angle2) * fovRadius)
        
        local line = fovDrawings[i]
        if line then
            line.From = p1
            line.To = p2
            line.Color = rainbowColor
            line.Visible = fovEnabled
        end
    end
end

local function setFOVVisible(visible)
    for _, line in ipairs(fovDrawings) do
        line.Visible = visible
    end
end

local function updateFOVSize(radius)
    fovRadius = radius or 150
    H = fovRadius
end

b.RenderStepped:Connect(function()
