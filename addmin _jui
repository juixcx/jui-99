local bt = j.tween
j.tween = function(bu, bv, bw)
    if bu and bu:IsA("NumberValue") and bw and bw.Value ~= nil then
        bu.Value = bw.Value
        return {Cancel = function() end}
    end
    return bt(bu, bv, bw)
end

