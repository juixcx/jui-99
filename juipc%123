-- Velocity Tracking
local velHistoryCount = 6
local velMultiplier = 1.2
local velYThreshold = 150
local lerpFactor = 0.75
local velData = {}
local smoothedTarget = Vector3.new()

b.Heartbeat:Connect(function()
    for _, player in ipairs(a:GetPlayers()) do
        if player ~= r and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local hum = player.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                velData[player] = velData[player] or {}
                table.insert(velData[player], {time = os.clock(), pos = hrp.Position})
                if #velData[player] > velHistoryCount then table.remove(velData[player], 1) end
            else velData[player] = nil end
        end
    end
end)

a.PlayerRemoving:Connect(function(p) velData[p] = nil end)

local function calculateVelocity(player)
    local history = velData[player]
    if not history or #history < 2 then return Vector3.new() end
    local totalVel = Vector3.new()
    local count = 0
    for i = 2, #history do
        local dt = history[i].time - history[i - 1].time
        if dt > 0 then totalVel = totalVel + (history[i].pos - history[i - 1].pos) / dt count = count + 1 end
    end
    if count == 0 then return Vector3.new() end
    local avg = totalVel / count
    if avg.Y > velYThreshold then return Vector3.new(avg.X * 1.15, math.clamp(avg.Y * 0.85, 0, 400), avg.Z * 1.15) end
    return avg
end

local function predictPositionVel(head, root)
    if not head then return Vector3.zero end
    local player = head.Parent and a:GetPlayerFromCharacter(head.Parent)
    if not player then return head.Position end
    local vel = calculateVelocity(player) or Vector3.zero
    local ping = getPing() or 0.1
    return head.Position + (vel * ping * velMultiplier)
end

