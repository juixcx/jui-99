local function getRarityColor(item)
    if item.Name == "Money" then return Color3.fromRGB(0, 255, 0) end
    for _, folder in ipairs(p:GetChildren()) do
        if folder:IsA("Folder") then
            local match = folder:FindFirstChild(item.Name)
            if match and match:GetAttribute("RarityName") then return at[match:GetAttribute("RarityName")] or Color3.fromRGB(255, 255, 255) end
        end
    end
    return Color3.fromRGB(255, 255, 255)
end

local function cleanupItemDrawings()
    for item, data in pairs(w) do
        if not item or not item.Parent then
            if data.circle then pcall(function() data.circle:Remove() end) end
            if data.innerCircle then pcall(function() data.innerCircle:Remove() end) end
            if data.name then pcall(function() data.name:Remove() end) end
            if data.amount then pcall(function() data.amount:Remove() end) end
            if data.highlight then pcall(function() data.highlight:Destroy() end) end
            w[item] = nil
        end
    end
end

b.RenderStepped:Connect(function()
    cleanupItemDrawings()
    if not x then return end
    local root = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, data in pairs(w) do
        data.circle.Visible = false data.innerCircle.Visible = false data.name.Visible = false data.amount.Visible = false
        if data.highlight then data.highlight.Enabled = false end
    end
    local items = {}
    for _, item in ipairs(x:GetChildren()) do
        if item:IsA("Model") and item:FindFirstChild("PickUpZone") and not item:GetAttribute("Locked") then
            local ok, pos = pcall(function() return item.PickUpZone.Position end)
            if ok and pos then table.insert(items, {item = item, dist = (pos - root.Position).Magnitude}) end
        end
    end
    table.sort(items, function(a, b) return a.dist < b.dist end)
    for i = 1, math.min(20, #items) do
        local entry = items[i]
        local data = w[entry.item]
        if not data then
            data = { circle = Drawing.new("Circle"), innerCircle = Drawing.new("Circle"), name = Drawing.new("Text"), amount = Drawing.new("Text") }
            data.circle.Thickness = 2 data.circle.Transparency = 0.7 data.circle.Filled = false
            data.innerCircle.Thickness = 2 data.innerCircle.Transparency = 1 data.innerCircle.Filled = true
            data.name.Outline = true data.name.Center = true data.name.Size = 16 data.name.Font = 4
            data.amount.Outline = true data.amount.Center = true data.amount.Size = 13 data.amount.Color = Color3.fromRGB(200, 200, 200)
            w[entry.item] = data
        end
        if not data.highlight or not data.highlight.Parent then
            local h = Instance.new("Highlight")
            h.FillTransparency = 0.5 h.OutlineTransparency = 0.1 h.Adornee = entry.item h.Parent = entry.item
            data.highlight = h
        end
        local pos, onScreen = camera:WorldToViewportPoint(entry.item.PickUpZone.Position)
        if onScreen then
            local color = getRarityColor(entry.item)
            local size = math.clamp(aA / pos.Z, 3, 6)
            if data.highlight then data.highlight.FillColor = color data.highlight.OutlineColor = color data.highlight.Enabled = true end
            data.circle.Position = Vector2.new(pos.X, pos.Y) data.circle.Radius = size + 5 data.circle.Color = color data.circle.Visible = true
            data.innerCircle.Position = Vector2.new(pos.X, pos.Y) data.innerCircle.Radius = size data.innerCircle.Color = color data.innerCircle.Visible = true
            data.name.Color = color data.name.Position = Vector2.new(pos.X, pos.Y - size - 20) data.name.Text = entry.item.Name data.name.Visible = true
            local amount = entry.item:GetAttribute("Amount") or 1
            data.amount.Position = Vector2.new(pos.X, pos.Y + size + 15)
            data.amount.Text = amount > 1 and "[" .. tostring(amount) .. "]" or ""
            data.amount.Visible = amount > 1
        end
    end
end)

