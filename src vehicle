-- ── หารถ ──
local function findFlyVehicle()
	local char = Client.Character
	if not char then return nil end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid or not humanoid.SeatPart then return nil end
	local seat = humanoid.SeatPart
	local model = seat:FindFirstAncestorOfClass("Model")
	if not model then return { chassis = seat, model = seat.Parent } end
	local chassis = model.PrimaryPart
	if not chassis then
		local largest, size = nil, 0
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and not p:IsA("VehicleSeat") then
				if p.Size.Magnitude > size then size = p.Size.Magnitude; largest = p end
			end
		end
		chassis = largest or seat
	end
	return { chassis = chassis, model = model }
end

-- ── ปิด Physics + ปิดการชน ──
local function disableSlowdown(model)
	disabledConstraints = {}
	originalCollide = {}
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("HingeConstraint") or obj:IsA("CylindricalConstraint") then
			if obj.Enabled then obj.Enabled = false; table.insert(disabledConstraints, obj) end
		end
	end
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= bodyPart then
			originalCollide[p] = { CanCollide = p.CanCollide }
			p.CanCollide = false
			local n = p.Name:lower()
			if n:find("wheel") or n:find("tire") or n:find("ล้อ") then
				originalProps[p] = { Massless = p.Massless }
				p.Massless = true
			end
		end
	end
	if bodyPart then
		originalCollide[bodyPart] = { CanCollide = bodyPart.CanCollide }
		bodyPart.CanCollide = false
	end
end
local function restoreSlowdown()
	for _, c in ipairs(disabledConstraints) do if c and c.Parent then c.Enabled = true end end
	for p, prop in pairs(originalProps) do if p and p.Parent then p.Massless = prop.Massless end end
	for p, prop in pairs(originalCollide) do if p and p.Parent then p.CanCollide = prop.CanCollide end end
	disabledConstraints = {}
	originalProps = {}
	originalCollide = {}
end

-- ── เริ่มบิน ──
local function startFlying()
	local vehicle = findFlyVehicle()
	if not vehicle or not vehicle.chassis then
		warn("❌ ไม่พบรถ — กรุณานั่งบน VehicleSeat")
		return
	end
	bodyPart = vehicle.chassis
	currentVehicleModel = vehicle.model
	savedCFrame = bodyPart.CFrame
	savedLookVector = bodyPart.CFrame.LookVector
	bodyPart.CFrame = bodyPart.CFrame + Vector3.new(0, LIFT_HEIGHT, 0)
	disableSlowdown(vehicle.model)

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "FlyVelocity"
	bodyVelocity.MaxForce = Vector3.new(MAX_FORCE, MAX_FORCE, MAX_FORCE)
	bodyVelocity.P = 12000
	bodyVelocity.Velocity = Vector3.new(0, 0, 0)
	bodyVelocity.Parent = bodyPart

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "FlyGyro"
	bodyGyro.MaxTorque = Vector3.new(MAX_TORQUE, MAX_TORQUE, MAX_TORQUE)
	bodyGyro.P = 10000
	bodyGyro.D = 500
	bodyGyro.CFrame = CFrame.lookAt(Vector3.zero, savedLookVector)
	bodyGyro.Parent = bodyPart

	isFlying = true
	flyBtn.Text = "✈️ FLY: ON"
	flyBtn.BackgroundColor3 = PURPLE_MAIN

	analogGui.Visible = true
	upBtn.Visible = true
	downBtn.Visible = true

	connection = RunService.RenderStepped:Connect(function(dt)
		if not isFlying or not bodyPart or not bodyPart.Parent then return end
		local camCFrame = camera.CFrame
		local camLook = camCFrame.LookVector
		local camRight = camCFrame.RightVector
		local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
		local flatRight = Vector3.new(camRight.X, 0, camRight.Z)
		if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end
		if flatRight.Magnitude > 0.01 then flatRight = flatRight.Unit end

		local moveDir = Vector3.new(0, 0, 0)
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += flatLook end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= flatLook end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= flatRight end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += flatRight end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end

		if inputVector.Magnitude > 0.1 then
			moveDir += flatLook * (-inputVector.Y)
			moveDir += flatRight * inputVector.X
		end
		if upPressed then moveDir += Vector3.new(0, 1, 0) end
		if downPressed then moveDir -= Vector3.new(0, 1, 0) end

		if moveDir.Magnitude > 0 then
			bodyVelocity.Velocity = moveDir.Unit * SPEED
		else
			bodyVelocity.Velocity = Vector3.new(0, 0, 0)
		end

		if moveDir.Magnitude > 0 then
			local dir = Vector3.new(moveDir.X, 0, moveDir.Z)
			if dir.Magnitude > 0.01 then
				bodyGyro.CFrame = CFrame.lookAt(Vector3.zero, dir.Unit)
			end
		else
			local currentLook = bodyPart.CFrame.LookVector
			local flatCurrent = Vector3.new(currentLook.X, 0, currentLook.Z)
			if flatCurrent.Magnitude > 0.01 then
				bodyGyro.CFrame = CFrame.lookAt(Vector3.zero, flatCurrent.Unit)
			end
		end
	end)
end

-- ── หยุดบิน ──
local function stopFlying()
	isFlying = false
	flyBtn.Text = "✈️ FLY: OFF"
	flyBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)

	analogGui.Visible = false
	upBtn.Visible = false
	downBtn.Visible = false

	if connection then connection:Disconnect() connection = nil end

	if bodyPart and bodyPart.Parent then
		savedCFrame = bodyPart.CFrame
		savedLookVector = bodyPart.CFrame.LookVector
		bodyPart.Anchored = true
		bodyPart.AssemblyLinearVelocity = Vector3.zero
		bodyPart.AssemblyAngularVelocity = Vector3.zero
	end
	if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
	if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	restoreSlowdown()

	if bodyPart and bodyPart.Parent and savedCFrame then
		local part = bodyPart
		local targetCF = savedCFrame
		local t = 0
		if freezeConn then freezeConn:Disconnect() end
		freezeConn = RunService.Heartbeat:Connect(function(dt)
			if not part or not part.Parent then
				if freezeConn then freezeConn:Disconnect() freezeConn = nil end
				return
			end
			part.CFrame = targetCF
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
			t += dt
			if t > FREEZE_TIME then
				part.Anchored = false
				if freezeConn then freezeConn:Disconnect() freezeConn = nil end
			end
		end)
	end

	if currentVehicleModel and savedLookVector then
		local model = currentVehicleModel
		local mp = model.PrimaryPart or bodyPart
		local keepLook = savedLookVector
		if postLockConn then postLockConn:Disconnect() postLockConn = nil end
		if currentLockGyro and currentLockGyro.Parent then currentLockGyro:Destroy() end
		if mp and mp.Parent then
			currentLockGyro = Instance.new("BodyGyro")
			currentLockGyro.Name = "FlyCarDirectionLock"
			currentLockGyro.MaxTorque = Vector3.new(0, 1e7, 0)
			currentLockGyro.P = 50000
			currentLockGyro.D = 1000
			currentLockGyro.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(keepLook.X, 0, keepLook.Z).Unit)
			currentLockGyro.Parent = mp

			local oldGyros = {}
			for _, obj in ipairs(model:GetDescendants()) do
				if obj:IsA("BodyGyro") and obj ~= currentLockGyro and obj.Enabled then
					obj.Enabled = false
					table.insert(oldGyros, obj)
				end
			end
			local lockT = 0
			postLockConn = RunService.Heartbeat:Connect(function(dt)
				if not mp or not mp.Parent then
					if postLockConn then postLockConn:Disconnect() postLockConn = nil end
					return
				end
				mp.AssemblyAngularVelocity = Vector3.zero
				lockT += dt
				if lockT > DIR_LOCK_TIME then
					for _, g in ipairs(oldGyros) do if g and g.Parent then g.Enabled = true end end
					if currentLockGyro and currentLockGyro.Parent then currentLockGyro:Destroy() currentLockGyro = nil end
					if postLockConn then postLockConn:Disconnect() postLockConn = nil end
				end
			end)
		end
	end

	bodyPart = nil
	savedCFrame = nil
	savedLookVector = nil
	currentVehicleModel = nil
end

