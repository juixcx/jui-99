-- ── Analog Logic ──
local analogActive = false
local inputVector = Vector2.new(0, 0)
local KNOB_RADIUS = 80

local function updateKnob(pos)
	local center = analogGui.AbsolutePosition + analogGui.AbsoluteSize / 2
	local delta = Vector2.new(pos.X - center.X, pos.Y - center.Y)
	if delta.Magnitude > KNOB_RADIUS then delta = delta.Unit * KNOB_RADIUS end
	knob.Position = UDim2.new(0.5, delta.X - 40, 0.5, delta.Y - 40)
	inputVector = Vector2.new(delta.X / KNOB_RADIUS, delta.Y / KNOB_RADIUS)
end
local function resetKnob()
	knob.Position = UDim2.new(0.5, -40, 0.5, -40)
	inputVector = Vector2.new(0, 0)
end

