-- Vehicle Mod System
-- ═══════════════════════════════════════════════════
local Storage = {
	Vehicle_Attributes = {
		{ Name = "acceleration", Type = "number", Min = 5, Max = 100, DisplayName = "Acceleration" },
		{ Name = "slipThreshold", Type = "number", Min = 10, Max = 100, DisplayName = "Slip Threshold" },
		{ Name = "staticFriction", Type = "number", Min = 1, Max = 10, DisplayName = "Static Friction" },
	},
}
local FindVehicle = function()
	local Vehicles = workspace:WaitForChild("Vehicles")
	local LocalUserId = Client.UserId
	for _, Vehicle in next, Vehicles:GetChildren() do
		if Vehicle:GetAttribute("OwnerUserId") == LocalUserId then
			return { Vehicle = Vehicle, Name = Vehicle.Name }
		end
	end
	local Character = Client.Character
	if Character then
		local Hum = Character:FindFirstChildOfClass("Humanoid")
		if Hum and Hum.SeatPart then
			local Vehicle = Hum.SeatPart.Parent
			return { Vehicle = Vehicle, Name = Vehicle.Name }
		end
	end
	return nil
end

local VehicleModSystem = {
	AttributeInfos = Storage.Vehicle_Attributes,
	TorqueAttributes = { "maxSpeedTorque", "minSpeedTorque" },
	AttributeCache = setmetatable({}, { __mode = "k" }),
	ChassisCache = setmetatable({}, { __mode = "k" }),
	LastVehicle = nil,
}
local function defaultSnapshot()
	return { hadCustom = false, density = nil, densityFallback = 1, friction = 0.3, elasticity = 0, frictionWeight = 1, elasticityWeight = 1 }
end
function VehicleModSystem:CaptureChassisState(chassis)
	local cur = chassis.CustomPhysicalProperties
	if cur then
		return { hadCustom = true, density = cur.Density, friction = cur.Friction, elasticity = cur.Elasticity, frictionWeight = cur.FrictionWeight, elasticityWeight = cur.ElasticityWeight, densityFallback = cur.Density }
	end
	return defaultSnapshot()
end
function VehicleModSystem:RestoreChassisState(chassis, cache)
	if not cache then return end
	if cache.hadCustom and cache.density then
		chassis.CustomPhysicalProperties = PhysicalProperties.new(cache.density, cache.friction, cache.elasticity, cache.frictionWeight, cache.elasticityWeight)
	else
		pcall(function() chassis.CustomPhysicalProperties = nil end)
	end
end
function VehicleModSystem:IsValid(inst)
	return inst ~= nil and typeof(inst) == "Instance" and inst.Parent ~= nil
end
function VehicleModSystem:StoreOriginal(inst, attr, value)
	if not self:IsValid(inst) then return end
	local cache = self.AttributeCache[inst]
	if not cache then cache = {}; self.AttributeCache[inst] = cache end
	if cache[attr] == nil then cache[attr] = value end
end
function VehicleModSystem:ApplyAttributeFolder(folder)
	if not self:IsValid(folder) then return end
	for _, info in ipairs(self.AttributeInfos) do
		local cur = folder:GetAttribute(info.Name)
		if cur ~= nil then
			self:StoreOriginal(folder, info.Name, cur)
			local newVal = G_Option("VehicleMods_" .. info.Name)
			if newVal ~= nil then folder:SetAttribute(info.Name, newVal) end
		end
	end
	local tm = G_Option("VehicleMods_TorqueMultiplier") or 1
	for _, attr in ipairs(self.TorqueAttributes) do
		local cur = folder:GetAttribute(attr)
		if cur ~= nil then
			self:StoreOriginal(folder, attr, cur)
			local orig = self.AttributeCache[folder] and self.AttributeCache[folder][attr]
			if type(orig) == "number" then folder:SetAttribute(attr, orig * tm) end
		end
	end
end
function VehicleModSystem:ApplyAttributeModifiers(vehicle)
	for _, child in ipairs(vehicle:GetChildren()) do
		if child:IsA("Folder") then self:ApplyAttributeFolder(child) end
	end
end
function VehicleModSystem:ApplySlamModifier(vehicle)
	local chassis = vehicle:FindFirstChild("Chassis")
	if not (chassis and chassis:IsA("BasePart")) then return end
	if G_Toggle("VehicleSlam") then
		if not self.ChassisCache[chassis] then self.ChassisCache[chassis] = self:CaptureChassisState(chassis) end
		local c = self.ChassisCache[chassis] or defaultSnapshot()
		chassis.CustomPhysicalProperties = PhysicalProperties.new(50, c.friction or 0.3, c.elasticity or 0, c.frictionWeight or 1, c.elasticityWeight or 1)
	else
		local c = self.ChassisCache[chassis]
		if c then self:RestoreChassisState(chassis, c); self.ChassisCache[chassis] = nil end
	end
end
function VehicleModSystem:PruneCache()
	for i in pairs(self.AttributeCache) do if not self:IsValid(i) then self.AttributeCache[i] = nil end end
	for i in pairs(self.ChassisCache) do if not self:IsValid(i) then self.ChassisCache[i] = nil end end
end
function VehicleModSystem:RestoreSlam()
	for chassis, cache in pairs(self.ChassisCache) do
		if self:IsValid(chassis) then self:RestoreChassisState(chassis, cache) end
		self.ChassisCache[chassis] = nil
	end
end
function VehicleModSystem:RevertVehicle(vehicle)
	for inst, attrMap in pairs(self.AttributeCache) do
		local should = (not vehicle) or (self:IsValid(inst) and inst:IsDescendantOf(vehicle))
		if should then
			if self:IsValid(inst) then
				for attr, orig in pairs(attrMap) do pcall(inst.SetAttribute, inst, attr, orig) end
			end
			self.AttributeCache[inst] = nil
		end
	end
	for chassis, cache in pairs(self.ChassisCache) do
		local should = (not vehicle) or (self:IsValid(chassis) and chassis:IsDescendantOf(vehicle))
		if should then
			if self:IsValid(chassis) then self:RestoreChassisState(chassis, cache) end
			self.ChassisCache[chassis] = nil
		end
	end
end
function VehicleModSystem:Reset()
	self:RevertVehicle(nil)
	self.LastVehicle = nil
end
function VehicleModSystem:Step()
	self:PruneCache()
	if not G_Toggle("VehicleModificationEnabled") then
		if self.LastVehicle then self:RevertVehicle(self.LastVehicle); self.LastVehicle = nil end
		self:RevertVehicle(nil)
		return
	end
	local vData = FindVehicle()
	local vehicle = vData and vData.Vehicle
	if not (vehicle and vehicle.Parent) then
		if self.LastVehicle then self:RevertVehicle(self.LastVehicle); self.LastVehicle = nil end
		return
	end
	if self.LastVehicle and self.LastVehicle ~= vehicle then self:RevertVehicle(self.LastVehicle) end
	self.LastVehicle = vehicle
	self:ApplyAttributeModifiers(vehicle)
	self:ApplySlamModifier(vehicle)
end

