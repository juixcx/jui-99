local function GetDistanceFromRootPart(target)
	if not target then return math.huge end
	local root = Client.Character and Client.Character:FindFirstChild("HumanoidRootPart")
	if not root then return math.huge end
	return (root.Position - target.Position).Magnitude
end
local function G_Toggle(name)
	if name == "VehicleModificationEnabled" then return VehicleModificationEnabled end
	if name == "VehicleSlam" then return VehicleSlam end
	return false
end
local function G_Option(name)
	if name == "VehicleMods_acceleration" then return VehicleMods_acceleration end
	if name == "VehicleMods_slipThreshold" then return VehicleMods_slipThreshold end
	if name == "VehicleMods_staticFriction" then return VehicleMods_staticFriction end
	if name == "VehicleMods_TorqueMultiplier" then return VehicleMods_TorqueMultiplier end
	if name == "VehicleMods_MaxSpeedMultiplier" then return VehicleMods_MaxSpeedMultiplier end
end

